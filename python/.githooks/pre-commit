#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."  # python/ ディレクトリへ

echo "── ruff check ────────────────────────────"
uv run ruff check src/ tests/

echo "── mypy ──────────────────────────────────"
uv run mypy src/

echo "── pytest ────────────────────────────────"
uv run pytest tests/ -q --tb=short

echo "✓ pre-commit checks passed"
